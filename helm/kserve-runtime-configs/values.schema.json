                                },
                                "memoryRequest": {
                                    "type": "string"
                                }
                            }
                        },
                        "scrapeInterval": {
                            "type": "string"
                        }
                    }
                },
                "security": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
