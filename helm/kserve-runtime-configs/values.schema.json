                                                    }
                                                }
                                            }
                                        },
                                        "privileged": {
                                            "type": "boolean"
                                        },
                                        "runAsNonRoot": {
                                            "type": "boolean"
                                        }
                                    }
                                },
                                "tag": {
                                    "type": "string"
                                }
                            }
