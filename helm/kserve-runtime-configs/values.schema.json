{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as this schema would otherwise not allow Helm's special 'global' values key."
        },
        "kserve": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "autoscaler": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "scaleDownStabilizationWindowSeconds": {
                            "type": "string"
                        },
                        "scaleUpStabilizationWindowSeconds": {
                            "type": "string"
                        }
                    }
                },
                "inferenceservice": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "resources": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "llmisvcConfigs": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Ship KServe's well-known `LLMInferenceServiceConfig` presets (`files/llmisvcconfigs`)."
                        },
                        "imageRegistry": {
                            "type": "string",
                            "description": "Registry prefix the presets' `ghcr.io/llm-d/` images are rewritten to at render time. The default is the digest-identical mirror set giantswarm/llm-d keeps on gsoci at the same tags; set `ghcr.io/llm-d/` to render upstream's images."
                        },
                        "images": {
                            "type": "object",
                            "description": "Per-preset image overrides, applied after the registry rewrite: `<preset name>: {<container name>: <image reference>}`. `main` is the runtime container of every preset, `llm-d-routing-sidecar` the routing sidecar of the decode presets; every other preset renders unchanged. See the README for the precedence and what an override image must provide.",
                            "additionalProperties": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "string"
                                }
                            }
                        },
                        "rolloutStrategy": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "maxSurge": {
                                    "type": [
                                        "string",
                                        "integer"
                                    ],
                                    "description": "Pods above the desired count during a roll (`maxSurge`), a number or a percentage; empty keeps the default.",
                                    "pattern": "^([0-9]+%?)?$"
                                },
                                "maxUnavailable": {
                                    "type": [
                                        "string",
                                        "integer"
                                    ],
                                    "description": "Pods below the desired count during a roll (`maxUnavailable`), a number or a percentage; empty keeps the default.",
                                    "pattern": "^([0-9]+%?)?$"
                                }
                            }
                        },
                        "tracing": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "exporterEndpoint": {
                                    "type": "string",
                                    "description": "OTLP/gRPC endpoint the vLLM and endpoint-picker exporters send spans to (`spec.tracing.exporterEndpoint`); upstream's is `http://otel-collector:4317`. vLLM and the endpoint picker export over gRPC only.",
                                    "pattern": "^(https?://[^\\s\"'#]+)?$"
                                },
                                "podLabels": {
                                    "type": "object",
                                    "description": "Labels the preset adds to the pods of an `LLMInferenceService` with tracing on (`spec.labels`, which the controller copies onto the workload pod template), e.g. the label an OTLP gateway routes a headerless export by. Not the prefill or endpoint-picker pods.",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                },
                                "sampler": {
                                    "type": "string",
                                    "description": "OpenTelemetry sampler (`spec.tracing.sampler`, `OTEL_TRACES_SAMPLER`); upstream's is `parentbased_traceidratio`.",
                                    "enum": [
                                        "",
                                        "always_on",
                                        "always_off",
                                        "traceidratio",
                                        "parentbased_always_on",
                                        "parentbased_always_off",
                                        "parentbased_traceidratio"
                                    ]
                                },
                                "samplerArg": {
                                    "type": "string",
                                    "description": "Sampler argument (`spec.tracing.samplerArg`, `OTEL_TRACES_SAMPLER_ARG`), a ratio between 0 and 1 for the ratio samplers; upstream's is `\"0.05\"`.",
                                    "pattern": "^((0(\\.[0-9]+)?)|(1(\\.0+)?))?$"
                                }
                            }
                        }
                    }
                },
                "opentelemetryCollector": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "metricReceiverEndpoint": {
